JWT_SECRET=coloquesua-chave-secreta-aqui
PORT=3000
LOG_LEVEL=info

AWS_REGION=us-east-1

# Vazio localmente = usa http://localhost:8000 (amazon/dynamodb-local via
# docker-compose). Preencher apenas ao apontar para o DynamoDB real da AWS.
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_ORCAMENTOS=billing-orcamentos
DYNAMODB_TABLE_PAGAMENTOS=billing-pagamentos
DYNAMODB_TABLE_WEBHOOK_LOGS=billing-webhook-logs

# Mercado Pago. Vazio = usa o gateway fake (ver
# infraestructure/mercadopago/fake-mercadopago-gateway.ts) - nao ha conta
# de sandbox real configurada ainda (ver README, secao "Pendencias").
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Saga (SNS/SQS FIFO, ver oficina-messaging-infra). Vazio = publisher no-op
# e consumidor desabilitado - ok para desenvolvimento local sem AWS.
SAGA_TOPIC_ARN=
SAGA_QUEUE_URL=
